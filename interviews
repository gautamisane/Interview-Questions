// Get full objects
const zeroInventoryItems = [];
for (const key in inventory) {
  if (inventory[key].quantity === 0) {
    zeroInventoryItems.push({ key: key, ...inventory[key] });
  }
}
console.log("Full Zero Inventory Items:", zeroInventoryItems);

// Get only names
const zeroInventoryNames = [];
for (const key in inventory) {
  if (inventory[key].quantity === 0) {
    zeroInventoryNames.push(inventory[key].name);
